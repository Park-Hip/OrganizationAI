# Copy this file to `.env` and adjust for your machine.
# `.env` is git-ignored; never commit real credentials.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (set a local password below, then use the same URL-safe value in DATABASE_URL)
DATABASE_URL=postgresql+psycopg2://decisioncore:@localhost:5432/decisioncore

# Docker Compose interpolation (used by backend/docker-compose.yml)
POSTGRES_USER=decisioncore
POSTGRES_PASSWORD=
POSTGRES_DB=decisioncore
POSTGRES_PORT=5432
APP_PORT=8000