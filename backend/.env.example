# Copy this file to `.env` and adjust for your machine.
# `.env` is git-ignored; never commit real credentials.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (set a local password below, then use the same URL-safe value in DATABASE_URL)
DATABASE_URL=postgresql+psycopg2://decisioncore:@localhost:5432/decisioncore

# Docker Compose interpolation (used by backend/docker-compose.yml)
POSTGRES_USER=decisioncore
POSTGRES_PASSWORD=
POSTGRES_DB=decisioncore
POSTGRES_PORT=5432
APP_PORT=8000

# Isolated, synthetic-only test database used by the database integration tests.
# Run `docker compose up -d test-db` and export TEST_DATABASE_URL before the
# migration/service/immutability tests will run (they skip when unreachable).
POSTGRES_TEST_DB=decisioncore_test
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql+psycopg2://decisioncore:@localhost:5433/decisioncore_test