# Copy this file to `.env` and adjust for your machine.
# `.env` is git-ignored; never commit real credentials.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (local Docker Compose defaults; non-secret development-only values)
DATABASE_URL=postgresql+psycopg2://decisioncore:decisioncore@localhost:5432/decisioncore

# Docker Compose interpolation (used by backend/docker-compose.yml)
POSTGRES_USER=decisioncore
POSTGRES_PASSWORD=decisioncore
POSTGRES_DB=decisioncore
POSTGRES_PORT=5432
APP_PORT=8000